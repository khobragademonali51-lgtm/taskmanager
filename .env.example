# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# 1. Sign up / Log in to https://supabase.com
# 2. Create a new project and run 'supabase_schema.sql' in the Supabase SQL Editor
# 3. Go to Project Settings -> API and copy your Project URL & Service Role / Anon Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional: Dedicated Service Role key for backend administration
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_jwt_key_task_manager_project_2026_xyz
JWT_EXPIRE=30d
